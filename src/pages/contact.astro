---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
  title={`Contact — ${SITE_TITLE}`}
  description={`Contact the ${SITE_TITLE} editorial team. Submit a story tip, request a correction, or get in touch with our journalists.`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": `Contact — ${SITE_TITLE}`,
    "url": "https://zylvion.xyz/contact",
    "description": "Contact the Zylvion editorial team",
    "publisher": { "@type": "NewsMediaOrganization", "name": "Zylvion", "url": "https://zylvion.xyz" }
  })} />

  <div class="contact-page">
    <div class="contact-hero">
      <div class="container">
        <h1 class="contact-title">Contact Zylvion</h1>
        <p class="contact-subtitle">Story tips, corrections, press enquiries, and reader feedback — we read everything.</p>
      </div>
    </div>

    <div class="container">
      <div class="contact-grid">

        <div class="contact-form-wrap">
          <h2 class="contact-section-title">Send a Message</h2>
          <form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p hidden><label>Do not fill this: <input name="bot-field" /></label></p>

            <div class="form-group">
              <label for="name" class="form-label">Your name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required class="form-input" placeholder="Jane Smith" autocomplete="name" />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email address <span class="required">*</span></label>
              <input type="email" id="email" name="email" required class="form-input" placeholder="jane@example.com" autocomplete="email" />
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Subject <span class="required">*</span></label>
              <select id="subject" name="subject" required class="form-input">
                <option value="">Select a reason for contact</option>
                <option value="tip">Story tip or lead</option>
                <option value="correction">Correction request</option>
                <option value="press">Press or partnership enquiry</option>
                <option value="feedback">Reader feedback</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message <span class="required">*</span></label>
              <textarea id="message" name="message" required class="form-input form-textarea" rows="6" placeholder="Tell us what you’d like to share or ask..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary form-submit">Send message</button>
          </form>
        </div>

        <aside class="contact-info">
          <h2 class="contact-section-title">How We Can Help</h2>

          <div class="contact-reason">
            <div class="contact-reason-icon">📰</div>
            <div>
              <h3 class="contact-reason-title">Story Tips</h3>
              <p class="contact-reason-desc">Have information we should investigate? We protect source confidentiality and take all tips seriously, whether on or off record.</p>
            </div>
          </div>

          <div class="contact-reason">
            <div class="contact-reason-icon">✏️</div>
            <div>
              <h3 class="contact-reason-title">Corrections</h3>
              <p class="contact-reason-desc">Found a factual error? We appreciate the notification. Corrections are published promptly with clear disclosure.</p>
            </div>
          </div>

          <div class="contact-reason">
            <div class="contact-reason-icon">📬</div>
            <div>
              <h3 class="contact-reason-title">Press Enquiries</h3>
              <p class="contact-reason-desc">Media requests, partnership discussions, and syndication enquiries are welcome. Please describe your organisation in your message.</p>
            </div>
          </div>

          <div class="contact-reason">
            <div class="contact-reason-icon">💬</div>
            <div>
              <h3 class="contact-reason-title">Reader Feedback</h3>
              <p class="contact-reason-desc">We value reader input on our coverage, focus areas, and editorial decisions. Every message is read by our editorial team.</p>
            </div>
          </div>

          <div class="contact-note">
            <p>We aim to respond to all messages within <strong>3 business days</strong>. For urgent tips, please indicate this clearly in your subject line.</p>
          </div>
        </aside>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-hero { background: var(--surface); border-bottom: 1px solid var(--border); padding: 3rem 0 2.5rem; }
  .contact-title { font-family: var(--display); font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: 700; color: var(--text); margin-bottom: 0.5rem; }
  .contact-subtitle { font-family: var(--ui); font-size: 1rem; color: var(--dim); max-width: 500px; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding: 3rem 0 5rem; align-items: start; }
  .contact-section-title { font-family: var(--display); font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--accent); }
  .form-group { margin-bottom: 1.25rem; }
  .form-label { display: block; font-family: var(--ui); font-size: 0.78rem; font-weight: 600; color: var(--text); margin-bottom: 0.4rem; letter-spacing: 0.02em; }
  .required { color: var(--red); }
  .form-input { width: 100%; font-family: var(--ui); font-size: 0.9rem; background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 0.6rem 0.85rem; outline: none; transition: border-color 0.15s; appearance: none; }
  .form-input:focus { border-color: var(--accent); }
  .form-input::placeholder { color: var(--muted); }
  .form-textarea { resize: vertical; min-height: 140px; }
  .form-submit { width: 100%; justify-content: center; padding: 0.75rem; margin-top: 0.5rem; }
  .contact-reason { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
  .contact-reason-icon { font-size: 1.25rem; flex-shrink: 0; }
  .contact-reason-title { font-family: var(--display); font-size: 0.9rem; font-weight: 700; color: var(--text); margin-bottom: 0.35rem; }
  .contact-reason-desc { font-family: var(--ui); font-size: 0.82rem; color: var(--dim); line-height: 1.55; margin: 0; }
  .contact-note { background: var(--surface); border: 1px solid var(--border); padding: 1rem 1.25rem; margin-top: 1rem; font-family: var(--ui); font-size: 0.82rem; color: var(--dim); line-height: 1.55; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
