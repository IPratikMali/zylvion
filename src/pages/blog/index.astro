---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['AI', 'Security', 'Hardware', 'Policy', 'Crypto', 'Open Source'];
---

<BaseLayout
  title={`News — ${SITE_TITLE}`}
  description="Latest tech news, security research, and critical analysis from TechAudit."
>
  <div class="blog-index">
    <div class="blog-hero">
      <div class="container">
        <div class="blog-hero-inner">
          <div class="blog-hero-label">
            <span class="live-badge">
              <span class="live-dot"></span>
              LIVE COVERAGE
            </span>
          </div>
          <h1 class="blog-hero-title">Intelligence Feed</h1>
          <p class="blog-hero-desc">Breaking news, security research, and critical analysis from the frontlines of tech.</p>
        </div>
      </div>
    </div>

    <!-- Category Filter -->
    <div class="category-filter-bar">
      <div class="container">
        <div class="category-filters">
          <a href="/blog" class="filter-btn filter-btn--active">All</a>
          {categories.map(cat => (
            <a href={`/blog/?cat=${cat.toLowerCase().replace(' ', '-')}`} class="filter-btn">{cat}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="container blog-container">
      {posts.length === 0 ? (
        <div class="no-posts">
          <div class="no-posts-inner panel">
            <h2 class="no-posts-title">No Articles Yet</h2>
            <p>Check back soon — new intelligence drops daily.</p>
            <div class="no-posts-examples">
              <h3>Coverage areas:</h3>
              <div class="example-categories">
                {categories.map(cat => (
                  <span class={`category-badge ${cat.toLowerCase().replace(' ', '')}`}>{cat}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="posts-grid">
          {posts.map((post, i) => (
            <article class={`post-card article-card ${i === 0 ? 'post-card--featured' : ''}`}>
              <a href={`/blog/${post.id}`} class="post-card-link">
                <div class="post-card-content">
                  <div class="post-card-meta">
                    {post.data.tags.slice(0, 2).map(tag => (
                      <span class={`category-badge ${tag.toLowerCase()}`}>{tag}</span>
                    ))}
                    <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>
                      <FormattedDate date={post.data.pubDate} />
                    </time>
                  </div>
                  <h2 class="post-card-title">{post.data.title}</h2>
                  <p class="post-card-desc">{post.data.description}</p>
                  <div class="post-card-footer">
                    <span class="post-card-author">{post.data.author}</span>
                    <span class="post-card-read">Read →</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border2);
    padding: 3rem 0 2rem;
    position: relative;
    overflow: hidden;
  }

  .blog-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--neon);
  }

  .blog-hero-label {
    margin-bottom: 0.75rem;
  }

  .blog-hero-title {
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--neon);
    margin-bottom: 0.75rem;
  }

  .blog-hero-desc {
    color: var(--dim);
    font-size: 1.1rem;
    max-width: 600px;
    margin-bottom: 0;
  }

  .category-filter-bar {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    position: sticky;
    top: 56px;
    z-index: 100;
    backdrop-filter: blur(8px);
  }

  .category-filters {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    font-family: var(--display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    padding: 0.35rem 0.75rem;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.2s;
    border-radius: 2px;
  }

  .filter-btn:hover {
    color: var(--cyan);
    border-color: rgba(0,229,255,0.3);
  }

  .filter-btn--active {
    color: var(--neon);
    border-color: rgba(255,0,60,0.4);
    background: rgba(255,0,60,0.05);
  }

  .blog-container {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .post-card {
    background: var(--bg);
    transition: background 0.2s;
  }

  .post-card:hover { background: var(--surface); }

  .post-card--featured {
    grid-column: 1 / -1;
    background: var(--surface);
  }

  .post-card-link {
    display: block;
    text-decoration: none;
    height: 100%;
  }

  .post-card-content {
    padding: 1.5rem;
  }

  .post-card--featured .post-card-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .post-card--featured .post-card-meta {
    grid-column: 1;
    align-self: end;
  }

  .post-card-date { color: var(--dim); }

  .post-card-title {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .post-card:hover .post-card-title { color: var(--cyan); }

  .post-card--featured .post-card-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .post-card-desc {
    color: var(--dim);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .post-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--dim);
  }

  .post-card-read {
    color: var(--neon);
  }

  /* No posts state */
  .no-posts {
    padding: 4rem 0;
  }

  .no-posts-inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem;
    text-align: center;
  }

  .no-posts-title {
    font-family: var(--display);
    font-size: 1.5rem;
    color: var(--neon);
    margin-bottom: 1rem;
  }

  .no-posts-examples {
    margin-top: 2rem;
    text-align: left;
  }

  .no-posts-examples h3 {
    font-family: var(--display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.75rem;
  }

  .example-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 900px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .post-card--featured .post-card-content { grid-template-columns: 1fr; }
    .post-card--featured .post-card-meta { grid-column: auto; }
  }

  @media (max-width: 600px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
