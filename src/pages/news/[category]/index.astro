---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('news', ({ data }) => !data.draft);
  const categories = [...new Set(articles.map(a => a.data.category))];
  return categories.map(category => ({
    params: { category },
    props: {
      category,
      articles: articles
        .filter(a => a.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, articles } = Astro.props;
const title = `${category.charAt(0).toUpperCase() + category.slice(1)} News`;
const description = `Latest ${category} news and opinion pieces from Demo News Aggregator.`;
---

<BaseLayout title={title} description={description}>
  <div class="container" style="padding: 2rem 0 4rem">
    <nav class="breadcrumb">
      <a href="/">Home</a><span>›</span>
      <a href="/news">News</a><span>›</span>
      <span class="current">{title}</span>
    </nav>

    <div class="cat-header">
      <h1 class="cat-title">{title}</h1>
      <span class="cat-count">{articles.length} articles</span>
    </div>

    <div class="news-grid">
      {articles.map(article => {
        const parts = article.id.split('/');
        const slug = parts[parts.length - 1].replace(/\.(md|mdx)$/, '');
        return (
          <a href={`/news/${category}/${slug}`} class="news-card">
            <div class="nc-source">{article.data.sourceSite}</div>
            <h2 class="nc-title">{article.data.title}</h2>
            <p class="nc-desc">{article.data.description}</p>
            <div class="nc-meta">
              <span class="nc-time">{article.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            </div>
          </a>
        );
      })}
    </div>

    {articles.length === 0 && (
      <p style="color: var(--dim); text-align:center; padding: 4rem 0; font-family: var(--mono); font-size: 0.85rem;">
        No articles yet in this category. Check back soon.
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--dim);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--cyan); }
  .breadcrumb .current { color: var(--text); }

  .cat-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .cat-title {
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 900;
    color: var(--text);
    margin: 0;
    text-transform: capitalize;
  }

  .cat-count {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--dim);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
  }
</style>

<style is:global>
  .news-card {
    display: block;
    text-decoration: none;
    background: var(--bg);
    padding: 1rem;
    transition: background 0.15s;
  }
  .news-card:hover { background: var(--surface); }
  .nc-source {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.4rem;
  }
  .nc-title {
    font-family: var(--display);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    margin: 0 0 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card:hover .nc-title { color: var(--cyan); }
  .nc-desc {
    font-size: 0.75rem;
    color: var(--dim);
    line-height: 1.4;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nc-meta { margin-top: 0.5rem; }
  .nc-time { font-family: var(--mono); font-size: 0.65rem; color: var(--dim); opacity: 0.7; }
</style>
