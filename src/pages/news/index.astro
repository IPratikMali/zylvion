---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = await getCollection('news', ({ data }) => !data.draft);
articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(articles.map(a => a.data.category))].sort();
const recent = articles.slice(0, 60);
---

<BaseLayout title="News" description="Latest news and opinion pieces from Demo News Aggregator, covering tech, AI, business, travel, health and more.">
  <div class="container" style="padding: 2rem 0 4rem">
    <div class="news-header">
      <h1 class="news-title">All News</h1>
      <p class="news-sub">{articles.length} articles across {categories.length} categories</p>
    </div>

    <!-- Category nav -->
    <nav class="cat-nav">
      <a href="/news" class="cat-pill active">All</a>
      {categories.map(cat => (
        <a href={`/news/${cat}`} class="cat-pill">{cat}</a>
      ))}
    </nav>

    <!-- Grid -->
    <div class="news-grid">
      {recent.map(article => {
        const parts = article.id.split('/');
        const slug = parts[parts.length - 1].replace(/\.(md|mdx)$/, '');
        const category = article.data.category;
        return (
          <a href={`/news/${category}/${slug}`} class="news-card">
            <div class="nc-header">
              <span class="nc-source">{article.data.sourceSite}</span>
              <span class="nc-cat-pill">{category}</span>
            </div>
            <h2 class="nc-title">{article.data.title}</h2>
            <p class="nc-desc">{article.data.description}</p>
            <div class="nc-meta">
              <span class="nc-time">{article.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </a>
        );
      })}
    </div>

    {articles.length === 0 && (
      <div style="text-align:center; padding: 4rem 0;">
        <p style="color: var(--dim); font-family: var(--mono); font-size: 0.85rem;">
          No articles yet. The GitHub Action will generate them on the next scheduled run.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .news-header { margin-bottom: 1.5rem; }
  .news-title {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    color: var(--text);
    margin: 0 0 0.25rem;
  }
  .news-sub { font-family: var(--mono); font-size: 0.75rem; color: var(--dim); margin: 0; }

  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .cat-pill {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: capitalize;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border2);
    color: var(--dim);
    text-decoration: none;
    transition: all 0.15s;
  }
  .cat-pill:hover, .cat-pill.active {
    border-color: var(--cyan);
    color: var(--cyan);
    background: rgba(0,229,255,0.05);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
  }

  .nc-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }
  .nc-source {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .nc-cat-pill {
    font-family: var(--mono);
    font-size: 0.55rem;
    color: var(--dim);
    border: 1px solid var(--border2);
    padding: 0.1em 0.35em;
    text-transform: capitalize;
  }
  .nc-title {
    font-family: var(--display);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    margin: 0 0 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  a.news-card { display: block; text-decoration: none; background: var(--bg); padding: 1rem; transition: background 0.15s; }
  a.news-card:hover { background: var(--surface); }
  a.news-card:hover .nc-title { color: var(--cyan); }
  .nc-desc {
    font-size: 0.75rem;
    color: var(--dim);
    line-height: 1.4;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nc-meta { margin-top: 0.5rem; }
  .nc-time { font-family: var(--mono); font-size: 0.65rem; color: var(--dim); opacity: 0.7; }
</style>
