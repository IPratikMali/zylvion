---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
---

<BaseLayout
  title={`Terms of Service — ${SITE_TITLE}`}
  description="TechAudit terms of service — rules governing use of our website and content."
>
  <div class="legal-page">
    <div class="legal-hero">
      <div class="container">
        <span class="mono-tag">// LEGAL</span>
        <h1>Terms of Service</h1>
        <p class="legal-meta">
          <span>Effective: January 1, 2026</span>
        </p>
      </div>
    </div>

    <div class="container legal-body">
      <article class="prose legal-content">
        <h2>1. Acceptance of Terms</h2>
        <p>By accessing or using TechAudit at {SITE_URL} ("Site"), you agree to be bound by these Terms of Service. If you do not agree to these terms, do not use the Site.</p>

        <h2>2. Use of the Site</h2>
        <p>You may use the Site for lawful, personal, non-commercial purposes. You agree not to:</p>
        <ul>
          <li>Reproduce, distribute, or republish our content without written permission</li>
          <li>Scrape, crawl, or index the Site using automated tools without permission</li>
          <li>Attempt to gain unauthorized access to any portion of the Site</li>
          <li>Use the Site to transmit spam or malicious content</li>
          <li>Misrepresent your affiliation with any person or entity</li>
        </ul>

        <h2>3. Intellectual Property</h2>
        <p>All content on the Site — including text, graphics, logos, and code — is the property of TechAudit or its content suppliers and is protected by copyright law. You may share links to our articles. Brief quotations with proper attribution are permitted under fair use.</p>

        <h2>4. Disclaimer of Warranties</h2>
        <p>The Site is provided "as is" without warranty of any kind. We do not warrant that the Site will be error-free, uninterrupted, or free of viruses. Information on the Site is provided for informational purposes only and does not constitute professional advice.</p>

        <h2>5. Security Research Content</h2>
        <p>Security research, vulnerability disclosures, and technical analysis published on this Site are provided for educational purposes. TechAudit does not condone the use of this information for illegal purposes. Readers are responsible for compliance with applicable laws.</p>

        <h2>6. Limitation of Liability</h2>
        <p>To the maximum extent permitted by law, TechAudit shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of or inability to use the Site.</p>

        <h2>7. Third-Party Links</h2>
        <p>The Site may contain links to third-party websites. We have no control over and assume no responsibility for the content, privacy policies, or practices of third-party sites.</p>

        <h2>8. Newsletter</h2>
        <p>By subscribing to our newsletter, you consent to receive periodic emails about tech news and our content. You may unsubscribe at any time. We do not send spam or sell your email address.</p>

        <h2>9. Changes to Terms</h2>
        <p>We reserve the right to modify these terms at any time. Changes will be posted on this page. Continued use of the Site after changes constitutes acceptance.</p>

        <h2>10. Governing Law</h2>
        <p>These Terms shall be governed by and construed in accordance with applicable law. Any disputes shall be resolved through binding arbitration.</p>

        <h2>11. Contact</h2>
        <p>
          For questions about these Terms:<br />
          <a href="/contact">techaudit.in/contact/</a>
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border2);
    padding: 3rem 0 2rem;
    position: relative;
  }

  .legal-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--neon);
  }

  .mono-tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--neon);
    display: block;
    margin-bottom: 1rem;
  }

  .legal-hero h1 {
    font-family: var(--display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .legal-meta {
    display: flex;
    gap: 2rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim);
    flex-wrap: wrap;
    margin: 0;
  }

  .legal-body {
    padding: 3rem 0 5rem;
  }

  .legal-content {
    max-width: 760px;
  }
</style>
