---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const coverageAreas = [
  {
    icon: '⬡',
    title: 'Artificial Intelligence',
    desc: 'LLM benchmarks, model releases, safety research, AI policy, and enterprise adoption. We go beyond the press releases.',
    color: 'var(--purple)',
  },
  {
    icon: '⬡',
    title: 'Cybersecurity',
    desc: 'CVE analysis, APT tracking, malware reverse engineering, zero-days, and defensive research. Technical depth, not FUD.',
    color: 'var(--neon)',
  },
  {
    icon: '⬡',
    title: 'Hardware',
    desc: 'Chip architectures, silicon news, GPU wars, embedded systems, and supply chain intelligence.',
    color: 'var(--green)',
  },
  {
    icon: '⬡',
    title: 'Policy & Regulation',
    desc: 'EU AI Act, US AI executive orders, GDPR enforcement, antitrust cases, and the politics shaping technology.',
    color: 'var(--cyan)',
  },
  {
    icon: '⬡',
    title: 'Crypto & Web3',
    desc: 'DeFi protocols, blockchain security, regulatory developments, and on-chain analytics without the hype.',
    color: 'var(--yellow)',
  },
  {
    icon: '⬡',
    title: 'Open Source',
    desc: 'Project launches, governance crises, licensing disputes, and the ecosystems shaping modern software.',
    color: 'var(--cyan)',
  },
];

const standards = [
  {
    title: 'Technical Accuracy',
    desc: 'We verify claims with primary sources — CVE databases, SEC filings, academic papers, and direct researcher contact.',
  },
  {
    title: 'No Sponsored Content',
    desc: 'Editorial is independent of advertising. We never publish paid-for "coverage" disguised as news.',
  },
  {
    title: 'Source Protection',
    desc: 'We protect whistleblowers and researchers who come to us with sensitive disclosures.',
  },
  {
    title: 'Corrections Policy',
    desc: 'We issue prominent corrections on factual errors and never quietly edit stories without disclosure.',
  },
];
---

<BaseLayout
  title={`About — ${SITE_TITLE}`}
  description="TechAudit covers breaking tech news, deep-dive security research, and critical analysis on AI, cybersecurity, hardware, and policy."
>
  <div class="about-page">
    <!-- Page Hero -->
    <div class="about-hero">
      <div class="container">
        <div class="hero-label">
          <span class="mono-tag">// ABOUT</span>
        </div>
        <h1 class="about-title">Built for Engineers.<br/>Not Executives.</h1>
        <p class="about-subtitle">{SITE_DESCRIPTION}</p>
      </div>
    </div>

    <div class="container">

      <!-- Mission -->
      <section class="about-section">
        <div class="section-header">
          <h2>Mission</h2>
        </div>
        <div class="mission-block panel">
          <p class="mission-text">
            TechAudit exists because the technology press has a depth problem. Surface-level summaries of press releases don't serve engineers, security researchers, or policy analysts who need to understand what's actually happening under the hood.
          </p>
          <p class="mission-text">
            We cover AI model releases with benchmark deep-dives, security vulnerabilities with actual PoC analysis, hardware announcements with architecture breakdowns, and policy developments with technical context — because the people building and defending the internet deserve better than corporate-sanitized tech media.
          </p>
          <div class="mission-stats">
            <div class="mission-stat">
              <span class="mission-stat-val">100%</span>
              <span class="mission-stat-label">Editorial Independence</span>
            </div>
            <div class="mission-stat">
              <span class="mission-stat-val">6</span>
              <span class="mission-stat-label">Coverage Areas</span>
            </div>
            <div class="mission-stat">
              <span class="mission-stat-val">Daily</span>
              <span class="mission-stat-label">Signal Newsletter</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Coverage Areas -->
      <section class="about-section">
        <div class="section-header">
          <h2>Coverage Areas</h2>
        </div>
        <div class="coverage-grid">
          {coverageAreas.map(area => (
            <div class="coverage-card panel">
              <div class="coverage-icon" style={`color: ${area.color}`}>◈</div>
              <h3 class="coverage-title" style={`color: ${area.color}`}>{area.title}</h3>
              <p class="coverage-desc">{area.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Editorial Standards -->
      <section class="about-section">
        <div class="section-header">
          <h2>Editorial Standards</h2>
        </div>
        <div class="standards-grid">
          {standards.map(s => (
            <div class="standard-item">
              <div class="standard-marker">▶</div>
              <div>
                <h3 class="standard-title">{s.title}</h3>
                <p class="standard-desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Contact CTA -->
      <section class="about-section about-cta panel">
        <h2 class="cta-title">Tip the Desk</h2>
        <p class="cta-desc">Got a security disclosure, leaked document, or story tip? We protect sources and take disclosures seriously.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-neon">Contact the Team</a>
          <a href="/rss.xml" class="btn btn-outline">Subscribe via RSS</a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .about-hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border2);
    padding: 4rem 0 3rem;
    position: relative;
    overflow: hidden;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--neon);
  }

  .mono-tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--neon);
    display: block;
    margin-bottom: 1rem;
  }

  .about-title {
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .about-subtitle {
    color: var(--dim);
    font-size: 1.1rem;
    max-width: 600px;
    line-height: 1.6;
    margin: 0;
  }

  .about-section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .about-section:last-child { border-bottom: none; }

  .mission-block {
    padding: 2rem;
  }

  .mission-text {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .mission-stats {
    display: flex;
    gap: 3rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border2);
    flex-wrap: wrap;
  }

  .mission-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mission-stat-val {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--cyan);
  }

  .mission-stat-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .coverage-card {
    padding: 1.75rem;
    border: none;
    border-radius: 0;
  }

  .coverage-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .coverage-title {
    font-family: var(--display);
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .coverage-desc {
    color: var(--dim);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .standard-item {
    display: flex;
    gap: 1rem;
  }

  .standard-marker {
    color: var(--neon);
    font-size: 0.75rem;
    padding-top: 0.2rem;
    flex-shrink: 0;
  }

  .standard-title {
    font-family: var(--display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .standard-desc {
    color: var(--dim);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .about-cta {
    padding: 2.5rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .cta-title {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--neon);
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    color: var(--dim);
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto 1.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .coverage-grid { grid-template-columns: repeat(2, 1fr); }
    .standards-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .coverage-grid { grid-template-columns: 1fr; }
  }
</style>
